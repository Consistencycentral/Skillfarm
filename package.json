{
  "name": "skillfarm-app",
  "version": "1.7.4",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && expo export --platform web && node scripts/post-export-fix.mjs && node scripts/subset-icons.mjs && node scripts/gen-sitemap.mjs",
    "deploy:web": "npm run build:web && wrangler pages deploy dist --project-name skillfarm --branch main --commit-dirty=true"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.1",
    "@expo-google-fonts/noto-sans-tamil": "^0.4.3",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "16.1.4",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@shopify/flash-list": "^2.0.2",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/query-async-storage-persister": "^5.85.5",
    "@tanstack/react-query": "^5.85.5",
    "expo": "~54.0.36",
    "expo-application": "~7.0.7",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.0",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.11",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.1",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.0",
    "expo-notifications": "~0.32.15",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.1",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.13",
    "expo-video": "~3.0.16",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "^6.3.20",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "~15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "subset-font": "^2.9.0",
    "typescript": "~5.9.2"
  }
}
