# Copy this file to ".env" and fill in your real values.
# Get these from Supabase: Project Settings -> API
#   EXPO_PUBLIC_SUPABASE_URL  = your Project URL (https://xxxx.supabase.co)
#   EXPO_PUBLIC_SUPABASE_ANON_KEY = the "anon public" key
#
# Variables prefixed with EXPO_PUBLIC_ are exposed to the app at build time.
# Never put the "service_role" key here — only the anon (public) key.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional deployed web origin used for password-reset/share links.
EXPO_PUBLIC_SITE_URL=https://skillfarm.netlify.app

# Supabase Edge Function / Razorpay configuration is NOT placed in this file.
# Set these as Supabase Function secrets instead:
#   RAZORPAY_KEY_ID
#   RAZORPAY_KEY_SECRET
#   RAZORPAY_WEBHOOK_SECRET
#   SKILLFARM_SITE_URL (optional, e.g. https://skillfarm.netlify.app)
